--- a/backend/app/engine/executor.py
+++ b/backend/app/engine/executor.py
@@ -1,30 +1,90 @@
-import subprocess
-def run(cmd: str):
-    return subprocess.run(cmd, shell=True)  # VULN R1/R2
+# P1+R2: list-based runner, no shell, Windows-safe (no shlex reliance).
+# Sources: https://docs.python.org/3/library/subprocess.html ("sequence preferred ... escaping")
+#          https://docs.python.org/3/library/shlex.html ("only designed for Unix shells")
+import os, re, shutil, subprocess
+_NAME = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9_.-]+$")
+_DOCKER = shutil.which("docker") or "docker"
+
+def run_docker(argv: list[str], timeout: int = 30, extra_env: dict | None = None):
+    assert isinstance(argv, list) and all(isinstance(a, str) for a in argv), "argv must be list[str]"
+    merged = {**os.environ, **(extra_env or {})}  # R4: never wipe PATH
+    return subprocess.run(
+        [_DOCKER, *argv],
+        capture_output=True, text=True, timeout=timeout,
+        shell=False, env=merged,
+    )
+
+def checked_name(name: str) -> str:
+    assert _NAME.match(name or ""), f"bad docker name: {name!r}"
+    return name
